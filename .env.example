# Optional webhook for the wake-up hook.
# Local runs only. In GitHub Actions these come from repository secrets.
# If either value is unset, notable events are logged as "would wake"
# to wakes.log and nothing is POSTed.
#
# CALEB_WATCHER_WEBHOOK_URL=https://example.invalid/wake
# CALEB_WATCHER_WEBHOOK_KEY=replace-me
